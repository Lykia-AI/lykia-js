{
  "name": "@lykia/mcp",
  "version": "0.2.1",
  "description": "Lykia MCP bridge: connects stdio MCP clients to Lykia's remote MCP server (images, video, speech and text from one key). Includes OAuth login and local file tools.",
  "license": "ISC",
  "homepage": "https://getlykia.com",
  "keywords": [
    "lykia",
    "mcp",
    "model-context-protocol",
    "ai",
    "image-generation",
    "video-generation",
    "text-to-speech"
  ],
  "type": "module",
  "bin": {
    "lykia-mcp": "dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.cjs",
    "dist/*.d.mts",
    "dist/*.d.cts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0"
  }
}
